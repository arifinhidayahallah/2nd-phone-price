    "\n",
    "joblib.dump(optimized_model, \"models/2nd_phone_price.pkl\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 23,
   "id": "50179b5a",
   "metadata": {},
   "outputs": [],
   "source": [
    "import json\n",
    "\n",
    "metadata = {\n",
    "    'selected_features': selected_features,\n",
    "    'hyperparameter': params\n",
    "}\n",
    "\n",
    "with open(\"models/metadata.json\", \"w\") as f:\n",
    "    json.dump(metadata, f, indent=4)"
   ]
  }
